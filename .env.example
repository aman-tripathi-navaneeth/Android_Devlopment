# Copy this file to backend/.env or export these variables in your shell/IDE.
# Never commit real credentials. Keep Atlas credentials on the backend only.
APP_NAME=Pharmacy Store Application API
APP_ENV=development
API_V1_PREFIX=/api/v1
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/pharmacy_store_dev
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
